Backport of two USB MIDI gadget fixes from Circle's develop branch (after Step 51.1.1):

- 1bcfb78d usbmidigadget: Reuse MIDI interface after reconfiguration (#720)
  Without it, a second enumeration (host reboot, replug while self-powered)
  fails the assertion in CUSBMIDIGadget::CreateDevice().
- 829a8c55 dwusbgadget: Synchronize receive buffers after DMA completion (#722)
  Discards cache lines refilled while DMA owned the receive buffer, so
  received MIDI data is not read stale.

Drop this patch when Circle is updated past these commits.

diff --git a/lib/usb/gadget/usbmidigadget.cpp b/lib/usb/gadget/usbmidigadget.cpp
index 479e1e99..ddc77929 100644
--- a/lib/usb/gadget/usbmidigadget.cpp
+++ b/lib/usb/gadget/usbmidigadget.cpp
@@ -239,7 +239,11 @@ void CUSBMIDIGadget::AddEndpoints (void)
 
 void CUSBMIDIGadget::CreateDevice (void)
 {
-	assert (!m_pInterface);
+	// The interface and endpoints survive bus reset and reconfiguration.
+	if (m_pInterface)
+	{
+		return;
+	}
 	m_pInterface = new CUSBMIDIDevice;
 	assert (m_pInterface);
 
diff --git a/include/circle/usb/gadget/dwusbgadgetendpoint.h b/include/circle/usb/gadget/dwusbgadgetendpoint.h
index 9d6dec94..0be2ff5b 100644
--- a/include/circle/usb/gadget/dwusbgadgetendpoint.h
+++ b/include/circle/usb/gadget/dwusbgadgetendpoint.h
@@ -117,6 +117,8 @@ protected:
 	/// \param nLength Number of bytes to be sent, or max. bytes to be received
 	/// \note pBuffer may be nullptr and nLength zero to transfer empty packets.
 	/// \note The buffer must be declared as DMA_BUFFER
+	/// \note Do not access the buffer or its cache lines until the transfer completes
+	///       or is canceled. DMA receive data is synchronized before OnTransferComplete().
 	void BeginTransfer (TTransferMode Mode, void *pBuffer, size_t nLength);
 
 	/// \brief Cancel a began transfer
diff --git a/lib/usb/gadget/dwusbgadgetendpoint.cpp b/lib/usb/gadget/dwusbgadgetendpoint.cpp
index abdefaf2..a0abc022 100644
--- a/lib/usb/gadget/dwusbgadgetendpoint.cpp
+++ b/lib/usb/gadget/dwusbgadgetendpoint.cpp
@@ -407,6 +407,12 @@ size_t CDWUSBGadgetEndpoint::FinishTransfer (void)
 	assert (nXferSize <= m_nTransferLength);
 	nXferSize = m_nTransferLength - nXferSize;
 
+	// Discard cache lines refilled while DMA owned the receive buffer.
+	if (m_TransferMode != TransferDataIn && nXferSize)
+	{
+		CleanAndInvalidateDataCacheRange ((uintptr) m_pTransferBuffer, nXferSize);
+	}
+
 #ifdef USB_GADGET_DEBUG
 	LOGDBG ("%u byte(s) transferred", nXferSize);
 
