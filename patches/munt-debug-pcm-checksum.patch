--- a/mt32emu/src/Synth.cpp
+++ b/mt32emu/src/Synth.cpp
@@ -2736,6 +2736,20 @@ bool Synth::isActive() {
 	return false;
 }
 
+Bit32u Synth::debugPCMWaveCount() const {
+	return opened ? controlROMMap->pcmCount : 0;
+}
+
+Bit32u Synth::debugPCMWaveChecksum(Bit32u waveNum) const {
+	if (!opened || waveNum >= controlROMMap->pcmCount) return 0;
+	const PCMWaveEntry &wave = pcmWaves[waveNum];
+	Bit32u sum = 0;
+	for (Bit32u i = 0; i < wave.len && wave.addr + i < pcmROMSize; i++) {
+		sum = sum * 31 + Bit16u(pcmROMData[wave.addr + i]);
+	}
+	return sum;
+}
+
 Bit32u Synth::getPartialCount() const {
 	return partialCount;
 }
